
type GameInfo {
    asset: String!
}

type Comment {
    wallet: String!
    content: String!
    txHash: String!
}

type Player {
    wallet: String!
    amountDeposited: String!
}

type Query {
    gameInfo: GameInfo!
    comments: [Comment!]!
    players: [Player!]!
}

type Mutation {
    postComment(
        content: String!,
        rr: String!,
        ss: String!,
        v: Int!
    ): Boolean
}
